---
import { withBase } from '../lib/url';
const pagefindUrl = withBase('pagefind/pagefind.js');
---

<button class="search-trigger" id="search-trigger" type="button" aria-label="Search docs" aria-keyshortcuts="Control+K Meta+K /">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
  <span class="search-trigger-label">Search</span>
  <kbd class="search-kbd" id="search-kbd">⌘K</kbd>
</button>

<dialog class="search-dialog" id="search-dialog" aria-label="Search documentation" data-pagefind-url={pagefindUrl} data-base={withBase()}>
  <div class="search-box">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input id="search-input" type="search" placeholder="Search all docs…" autocomplete="off" spellcheck="false" aria-label="Search query" />
    <kbd class="search-kbd">esc</kbd>
  </div>
  <ul class="search-results" id="search-results" role="listbox"></ul>
  <p class="search-status" id="search-status" aria-live="polite">Type to search the full text of every doc.</p>
</dialog>

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const trigger = document.getElementById('search-trigger')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const status = document.getElementById('search-status')!;

  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  const kbd = document.getElementById('search-kbd');
  if (kbd && !isMac) kbd.textContent = 'Ctrl K';

  type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta: Record<string, string> }> };
  let pagefind: { search: (q: string) => Promise<{ results: PagefindResult[] }>; options: (o: object) => Promise<void> } | null = null;
  let loadFailed = false;
  let seq = 0;
  let active = -1;

  async function loadPagefind() {
    if (pagefind || loadFailed) return;
    try {
      pagefind = await import(/* @vite-ignore */ dialog.dataset.pagefindUrl!);
      await pagefind!.options({ baseUrl: dialog.dataset.base });
    } catch {
      loadFailed = true;
      status.textContent = 'Search index not found — it is generated by `npm run build` (use `npm run preview` to try it).';
    }
  }

  function setActive(i: number) {
    const items = list.querySelectorAll<HTMLElement>('li');
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((el, n) => el.classList.toggle('is-active', n === active));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  async function run(query: string) {
    const mine = ++seq;
    if (!query.trim()) {
      list.replaceChildren();
      status.textContent = 'Type to search the full text of every doc.';
      return;
    }
    await loadPagefind();
    if (!pagefind) return;
    const { results } = await pagefind.search(query);
    const top = await Promise.all(results.slice(0, 8).map((r) => r.data()));
    if (mine !== seq) return;
    list.replaceChildren(
      ...top.map((r) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        const a = document.createElement('a');
        a.href = r.url;
        const title = document.createElement('strong');
        title.textContent = r.meta.title ?? r.url;
        a.append(title);
        if (r.meta.section) {
          const s = document.createElement('span');
          s.className = 'search-section';
          s.textContent = r.meta.section;
          a.append(s);
        }
        const ex = document.createElement('p');
        ex.innerHTML = r.excerpt; // Pagefind escapes everything except <mark>
        a.append(ex);
        li.append(a);
        return li;
      }),
    );
    status.textContent = top.length ? `${results.length} result${results.length === 1 ? '' : 's'}` : 'No results.';
    setActive(0);
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    input.select();
    loadPagefind();
  }

  trigger.addEventListener('click', open);
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  input.addEventListener('input', () => run(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') {
      list.querySelector<HTMLAnchorElement>('li.is-active a')?.click();
    }
  });

  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement)?.closest?.('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
</script>
