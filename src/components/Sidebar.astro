---
import type { SidebarItem } from '../lib/sidebar';
import { withBase } from '../lib/url';

interface Props {
  tree: SidebarItem[];
  activeSlug?: string;
}

const { tree, activeSlug } = Astro.props;
---

<aside class="sidebar" id="sidebar">
  <nav class="sidebar-nav" aria-label="Documentation">
    <ul class="sidebar-root">
      {tree.map((group) => {
        const isGroupActive = group.items.some((item) => item.slug === activeSlug);
        return (
          <li class={`sidebar-group ${isGroupActive ? 'is-active' : ''}`}>
            <button
              class="sidebar-group-toggle"
              aria-expanded={isGroupActive ? 'true' : 'false'}
              type="button"
            >
              <svg class="sidebar-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{group.label}</span>
            </button>
            <ul class="sidebar-items">
              {group.items.map((item) => (
                <li class={item.slug === activeSlug ? 'is-active' : ''}>
                  <a href={withBase(item.slug!)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>

<script>
  // Toggle sidebar groups
  document.querySelectorAll<HTMLButtonElement>('.sidebar-group-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.sidebar-group')?.classList.toggle('is-open');
    });
  });

  // Mobile sidebar toggle
  const toggle = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(sidebar.classList.contains('is-open')));
    });
    // Close on outside click
    document.addEventListener('click', (e) => {
      if (sidebar.classList.contains('is-open') && !sidebar.contains(e.target as Node) && e.target !== toggle) {
        sidebar.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
