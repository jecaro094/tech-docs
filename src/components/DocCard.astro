---
import type { SidebarItem } from '../lib/sidebar';
import { getSection } from '../lib/sections';
import { formatDate } from '../lib/doc-meta';
import { withBase } from '../lib/url';
import SectionIcon from './SectionIcon.astro';

interface Props {
  item: SidebarItem & { section: string };
  /** Show the section label (used in "Recently updated", where cards are not grouped). */
  showSection?: boolean;
}
const { item, showSection = false } = Astro.props;
const updated = formatDate(item.updated);
const tags = item.tags ?? [];
---

<a
  href={withBase(item.slug!)}
  class="feature-card"
  style={`--section:${getSection(item.section).color}`}
  data-doc-title={item.label.toLowerCase()}
  data-doc-tags={tags.join('|').toLowerCase()}
>
  <h3>{item.label}</h3>
  {item.description && <p>{item.description}</p>}
  <div class="card-foot">
    {showSection && (
      <span class="card-section"><SectionIcon name={item.section} size={13} />{item.section}</span>
    )}
    {updated && <span>{updated}</span>}
    {item.minutes && <span>{item.minutes} min</span>}
    {tags.map((t) => <span class="card-tag">{t}</span>)}
  </div>
</a>
