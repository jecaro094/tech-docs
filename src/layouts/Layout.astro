---
import '@jecaro/md-editor/styles/theme.css';
import '@jecaro/md-editor/styles/doc.css';
import '../styles/global.css';
import '../styles/project.css';
import '../styles/landing.css';
import '../styles/content.css';
import '../styles/sidebar.css';
import '../styles/breadcrumbs.css';
import '../styles/right-toc.css';
import '../styles/theme-toggle.css';
import '../styles/prev-next.css';
import '../styles/print.css';
import '../styles/lightbox.css';
import '../styles/search.css';
import '../styles/design.css';
import { EDITOR_ENABLED } from '../lib/editor-enabled';
import { withBase } from '../lib/url';
import type { SidebarItem } from '../lib/sidebar';
import Sidebar from '../components/Sidebar.astro';
import RightTOC from '../components/RightTOC.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import PrintButton from '../components/PrintButton.astro';
import SearchModal from '../components/SearchModal.astro';

interface TocItem {
  slug: string;
  text: string;
  children: { slug: string; text: string }[];
}

export interface Props {
  title: string;
  description?: string;
  /** Doc id. When set (and running under `astro dev`) the header shows an Edit link. */
  editSlug?: string;
  /** Sidebar tree data — when provided, renders the sidebar layout. */
  sidebarTree?: SidebarItem[];
  /** Currently active doc slug — highlights the item in the sidebar. */
  activeSlug?: string;
  /** Right-side TOC items — when provided, renders the right TOC panel. */
  tocItems?: TocItem[];
}

const {
  title,
  description = 'Landing page built with Astro',
  editSlug,
  sidebarTree,
  activeSlug,
  tocItems,
} = Astro.props;

const showEdit = EDITOR_ENABLED && Boolean(editSlug);
const currentYear = new Date().getFullYear();
const hasSidebar = Boolean(sidebarTree && sidebarTree.length > 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tech Docs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#252b36" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <script is:inline>
      // Apply stored theme before paint to avoid flash
      (function() {
        var t = localStorage.getItem('theme-preference') || 'dark';
        if (t !== 'auto') document.documentElement.setAttribute('data-theme', t);
        var os = localStorage.getItem('os-preference');
        if (!os) os = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent) ? 'mac' : 'ubuntu';
        document.documentElement.setAttribute('data-os', os);
        if (localStorage.getItem('sidebar-collapsed') === '1') {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header-left">
        {hasSidebar && (
          <>
            <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="Toggle sidebar" aria-expanded="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
            </button>
            <button class="sidebar-restore" id="sidebar-restore" type="button" aria-label="Show sidebar" title="Show sidebar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="9" y1="3" x2="9" y2="21"/>
              </svg>
            </button>
          </>
        )}
        <a class="brand" href={withBase()}>Tech Docs</a>
      </div>
      <nav aria-label="Sections">
        <a href={withBase()}>Docs</a>
        {showEdit && <a href={withBase(`editor/${editSlug}`)} class="edit-link">Edit</a>}
        <SearchModal />
        <PrintButton />
        <ThemeToggle />
      </nav>
    </header>

    {hasSidebar ? (
      <div class="doc-layout">
        <Sidebar tree={sidebarTree!} activeSlug={activeSlug} />
        <div class="doc-content" id="main-content" tabindex="-1">
          <slot />
        </div>
        {tocItems && tocItems.length > 0 && (
          <RightTOC items={tocItems} />
        )}
      </div>
    ) : (
      <div class="index-layout" id="main-content" tabindex="-1">
        <slot />
      </div>
    )}

    <footer class="site-footer">
      <p>&copy; {currentYear} Tech Docs · <a href="https://jecaro094.github.io">Portfolio</a></p>
    </footer>
  </body>
</html>

<script>
  function scrollToHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (target) {
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  window.addEventListener('load', scrollToHash);
  window.addEventListener('hashchange', scrollToHash);
</script>
