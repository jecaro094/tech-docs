---
import '../styles/global.css';
import '../styles/project.css';
import '../styles/landing.css';
import '@jecaro/md-editor/styles/doc.css';
import '../styles/content.css';

export interface Props {
  title: string;
  description?: string;
  /** Doc id. When set (and running under `astro dev`) the header shows an Edit link. */
  editSlug?: string;
}

const { title, description = 'Landing page built with Astro', editSlug } = Astro.props;
const showEdit = import.meta.env.DEV && Boolean(editSlug);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Tech Docs</a>
      <nav aria-label="Sections">
        <a href="/#docs">All docs</a>
        {showEdit && <a href={`/tech-docs/${editSlug}/edit`} class="edit-link">Edit</a>}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>&copy; {currentYear} Tech Docs</p>
    </footer>
  </body>
</html>

<script>
  function scrollToHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (target) {
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  window.addEventListener('load', scrollToHash);
  window.addEventListener('hashchange', scrollToHash);
</script>
