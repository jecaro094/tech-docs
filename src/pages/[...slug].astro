---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
import { buildSidebarTree, flattenSlugs } from '../lib/sidebar';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrevNext from '../components/PrevNext.astro';

export async function getStaticPaths() {
  const docs = await getCollection('techDocs');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const title = doc.data.title ?? doc.id;

// Build sidebar tree
const allDocs = await getCollection('techDocs');
const sidebarTree = buildSidebarTree(allDocs);
const flatSlugs = flattenSlugs(sidebarTree);

// Prev/Next
const currentIndex = flatSlugs.indexOf(doc.id);
const prev = currentIndex > 0
  ? { slug: flatSlugs[currentIndex - 1], label: allDocs.find((d) => d.id === flatSlugs[currentIndex - 1])?.data.title ?? flatSlugs[currentIndex - 1] }
  : null;
const next = currentIndex < flatSlugs.length - 1
  ? { slug: flatSlugs[currentIndex + 1], label: allDocs.find((d) => d.id === flatSlugs[currentIndex + 1])?.data.title ?? flatSlugs[currentIndex + 1] }
  : null;

// Breadcrumbs
const parts = doc.id.split('/');
const crumbs = [
  { label: 'Docs', href: withBase() },
  ...parts.map((part, i) => ({
    label: (allDocs.find((d) => d.id === parts.slice(0, i + 1).join('/'))?.data.title ?? part).replace(/-/g, ' '),
    href: undefined,
  })),
];

// Right TOC
const toc: { slug: string; text: string; children: { slug: string; text: string }[] }[] = [];
for (const heading of headings) {
  if (heading.depth === 2) {
    toc.push({ slug: heading.slug, text: heading.text, children: [] });
  } else if (heading.depth === 3 && toc.length > 0) {
    toc[toc.length - 1].children.push({ slug: heading.slug, text: heading.text });
  }
}
---

<Layout
  title={`${title} — Tech Docs`}
  description={doc.data.tagline}
  editSlug={doc.id}
  sidebarTree={sidebarTree}
  activeSlug={doc.id}
  tocItems={toc}
>
  <Breadcrumbs crumbs={crumbs} />
  <article class="doc doc-zoom">
    <a class="doc-back animate" style="animation-delay: 0.1s" href={withBase()}>← All docs</a>
    <div class="animate" style="animation-delay: 0.15s">
      <Content />
    </div>
  </article>
  <PrevNext prev={prev} next={next} />
</Layout>

<script>
  // OS switch — turn the title bar of every code frame inside a `:::mac` /
  // `:::ubuntu` block (src/lib/remark-os-blocks.ts) into macOS / Ubuntu tabs.
  // The choice lives on <html data-os> (set before paint by Layout.astro), is
  // shared by every block on the page and remembered in localStorage.
  const OS_OPTIONS = [
    { os: 'mac', label: 'macOS' },
    { os: 'ubuntu', label: 'Ubuntu' },
  ];

  document.querySelectorAll<HTMLElement>('.os-block .expressive-code .code-lang').forEach((lang) => {
    lang.classList.add('os-tabs');
    lang.setAttribute('role', 'tablist');
    lang.replaceChildren(
      ...OS_OPTIONS.map(({ os, label }) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.role = 'tab';
        btn.dataset.os = os;
        btn.textContent = label;
        return btn;
      }),
    );
  });

  function syncOsTabs() {
    const current = document.documentElement.dataset.os;
    document.querySelectorAll<HTMLButtonElement>('.os-tabs button').forEach((btn) => {
      btn.setAttribute('aria-selected', String(btn.dataset.os === current));
    });
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.os-tabs button');
    if (!btn?.dataset.os) return;
    document.documentElement.dataset.os = btn.dataset.os;
    try {
      localStorage.setItem('os-preference', btn.dataset.os);
    } catch {}
    syncOsTabs();
  });

  syncOsTabs();
</script>

<script>
  // Wire the copy button that rehypeCodeFrame adds around every <pre>.
  document.querySelectorAll<HTMLElement>('.expressive-code').forEach((frame) => {
    const btn = frame.querySelector<HTMLButtonElement>('.copy-btn');
    const pre = frame.querySelector('pre');
    if (!btn || !pre) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = '✓';
        btn.classList.add('copied');
      } catch {
        btn.textContent = '✕';
      }
      window.setTimeout(() => {
        btn.textContent = '⧉';
        btn.classList.remove('copied');
      }, 2000);
    });
  });

  // Media lightbox — doc images and Mermaid diagrams (now pre-rendered
  // server-side to static <img> data URIs, see src/lib/mermaid-render.ts —
  // both the dark and light variant are in the DOM at all times, toggled by
  // CSS on the site theme, so the selector below excludes whichever one is
  // currently hidden).
  {
    const ZOOMABLE_SELECTOR = '.doc-zoom img';

    function isVisible(el: HTMLElement): boolean {
      return el.offsetParent !== null;
    }

    function hasZoomables(): boolean {
      return Array.from(document.querySelectorAll<HTMLElement>(ZOOMABLE_SELECTOR)).some(isVisible);
    }

    if (hasZoomables()) {
      const overlay = document.createElement('div');
      overlay.className = 'doc-lightbox';
      overlay.innerHTML = `
        <button class="doc-lightbox-close" aria-label="Close">&times;</button>
        <button class="doc-lightbox-arrow doc-lightbox-prev" aria-label="Previous">&lsaquo;</button>
        <button class="doc-lightbox-arrow doc-lightbox-next" aria-label="Next">&rsaquo;</button>
        <span class="doc-lightbox-counter"></span>
        <span class="doc-lightbox-spinner"></span>
        <img class="doc-lightbox-img" />
      `;
      document.body.appendChild(overlay);

      const lbImg = overlay.querySelector<HTMLImageElement>('.doc-lightbox-img')!;
      const closeBtn = overlay.querySelector<HTMLButtonElement>('.doc-lightbox-close')!;
      const prevBtn = overlay.querySelector<HTMLButtonElement>('.doc-lightbox-prev')!;
      const nextBtn = overlay.querySelector<HTMLButtonElement>('.doc-lightbox-next')!;
      const counter = overlay.querySelector<HTMLSpanElement>('.doc-lightbox-counter')!;
      const spinner = overlay.querySelector<HTMLSpanElement>('.doc-lightbox-spinner')!;

      let zoomables: HTMLElement[] = [];
      let currentIndex = 0;

      function getSrc(el: HTMLElement): string {
        const img = el as HTMLImageElement;
        const link = img.closest<HTMLAnchorElement>('a');
        return link?.href ?? img.src;
      }

      function showImage(index: number) {
        currentIndex = index;
        const src = getSrc(zoomables[index]);
        spinner.classList.add('loading');
        lbImg.style.opacity = '0';
        lbImg.src = src;
        lbImg.onload = () => {
          spinner.classList.remove('loading');
          lbImg.style.opacity = '1';
        };
        counter.textContent = zoomables.length > 1 ? `${index + 1} / ${zoomables.length}` : '';
        prevBtn.disabled = index === 0;
        nextBtn.disabled = index === zoomables.length - 1;
      }

      function openLightbox(el: HTMLElement) {
        zoomables = Array.from(document.querySelectorAll<HTMLElement>(ZOOMABLE_SELECTOR)).filter(
          isVisible,
        );
        const index = zoomables.indexOf(el);
        showImage(index === -1 ? 0 : index);
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      function navigate(delta: number) {
        const next = currentIndex + delta;
        if (next >= 0 && next < zoomables.length) showImage(next);
      }

      // Click on overlay background or close button
      overlay.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (target === overlay || target === closeBtn) closeLightbox();
        if (target === prevBtn) navigate(-1);
        if (target === nextBtn) navigate(1);
      });

      // Keyboard: Escape, ArrowLeft, ArrowRight
      document.addEventListener('keydown', (e) => {
        if (!overlay.classList.contains('active')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navigate(-1);
        if (e.key === 'ArrowRight') navigate(1);
      });

      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest<HTMLElement>(ZOOMABLE_SELECTOR);
        if (target) openLightbox(target);
      });
    }
  }
</script>
