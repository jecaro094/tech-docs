---
/*
 * Dev-only Markdown editor.
 *
 * This page is a thin host around `@jecaro/md-editor`: it owns the DEV guard,
 * the `DOCS_DIR` filesystem access and the server render of the first preview,
 * then hands everything else — CodeMirror, the inline/split/source modes, dirty
 * tracking, toasts, the `/` menu — to `mountEditor`. On a static build
 * `import.meta.env.DEV` is false and this route 404s.
 */
export const prerender = false;

import fs from 'node:fs/promises';
import { resolveDocPath, DocPathError } from '../../../lib/docs';
import { renderMarkdown, splitFrontmatter } from '@jecaro/md-editor/markdown';
import '../../../styles/global.css';
import '@jecaro/md-editor/styles/editor.css';
import '@jecaro/md-editor/styles/doc.css';
import '@jecaro/md-editor/styles/inline.css';

if (!import.meta.env.DEV) {
  return new Response('The editor is only available under `astro dev`.', {
    status: 404,
  });
}

const { slug } = Astro.params;

let raw = '';
let initialHtml = '';
let loadError: string | null = null;

try {
  raw = await fs.readFile(resolveDocPath(slug), 'utf8');
  initialHtml = await renderMarkdown(splitFrontmatter(raw).body);
} catch (err) {
  if (err instanceof DocPathError) {
    loadError = err.message;
  } else if ((err as NodeJS.ErrnoException).code === 'ENOENT') {
    loadError = `No doc named "${slug}" in DOCS_DIR.`;
  } else {
    loadError = `Could not open doc: ${(err as Error).message}`;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Editing {slug} — Tech Docs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>html, body { height: 100%; margin: 0; } #app { height: 100%; }</style>
  </head>
  <body class="mde-host">
    {
      loadError ? (
        <div class="editor-error">
          <p>{loadError}</p>
          <p><a href="/">← Back to the index</a></p>
        </div>
      ) : (
        <>
          <div id="app" data-slug={slug} />
          <textarea id="doc-src" hidden>{raw}</textarea>
          <div id="initial-preview" hidden set:html={initialHtml} />
        </>
      )
    }

    <script>
      import { mountEditor } from '@jecaro/md-editor';
      import { remoteRenderer, httpSave } from '@jecaro/md-editor/adapters/http';

      const app = document.querySelector<HTMLElement>('#app');
      const srcEl = document.querySelector<HTMLTextAreaElement>('#doc-src');
      if (app && srcEl) {
        const slug = app.dataset.slug ?? '';
        mountEditor(app, {
          value: srcEl.value,
          mode: 'inline',
          title: `${slug}.md`,
          initialPreviewHtml:
            document.querySelector<HTMLElement>('#initial-preview')?.innerHTML,
          actions: [
            { label: '← Back', href: `/tech-docs/${slug}` },
            { label: 'View ↗', href: `/tech-docs/${slug}`, newTab: true },
          ],
          renderer: remoteRenderer('/api/preview'),
          onSave: httpSave('/api/save', { extra: { slug } }),
        });
      }
    </script>

    <style is:global>
      .editor-error {
        padding: 3rem 2rem;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--muted);
      }
      .editor-error a {
        color: var(--accent);
      }
    </style>
  </body>
</html>
