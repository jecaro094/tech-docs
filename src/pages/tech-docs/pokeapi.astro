---
import { getEntry, render } from 'astro:content';
import { Code } from 'astro:components';
import Layout from '../../layouts/Layout.astro';

const entry = await getEntry('techDocs', 'pokeapi');
const {
  title,
  tagline,
  subtitle,
  heroCta,
  demo,
  code,
  features,
  technologies,
  faqs,
  cta,
} = entry.data;
const { Content } = await render(entry);
---

<Layout title={`${title} — Tech Docs`} description={subtitle}>
  <main>
    {/* Hero */}
    <section class="hero animate" style="animation-delay: 0.1s">
      <h1 class="gradient-text">{title}</h1>
      <p class="tagline">{tagline}</p>
      <p class="subtitle">{subtitle}</p>
      <div class="cta-group">
        <a href={heroCta.primary.href} class="cta-btn primary"
          >{heroCta.primary.label}</a
        >
        <a href={heroCta.secondary.href} class="cta-btn secondary"
          >{heroCta.secondary.label}</a
        >
      </div>
    </section>

    {/* Context */}
    <section class="section animate" id="context" style="animation-delay: 0.15s">
      <h2>Context</h2>
      <Content />
    </section>

    {/* Features */}
    <section class="section animate" id="features" style="animation-delay: 0.2s">
      <h2>Features</h2>
      <div class="features-grid">
        {
          features.map((feature) => (
            <div class="feature-card">
              <div class="icon">{feature.icon}</div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* Code Example */}
    {
      code && (
        <section class="section animate" id="code" style="animation-delay: 0.4s">
          <h2>Code Example</h2>
          <div class="expressive-code">
            <div class="frame-header">
              <div class="dots">
                <span class="dot" />
                <span class="dot" />
                <span class="dot" />
              </div>
              <span>{code.filename}</span>
              <button
                class="copy-btn"
                type="button"
                aria-label="Copy code to clipboard"
              >
                Copy
              </button>
            </div>
            <Code code={code.source} lang={code.lang} theme="night-owl" />
          </div>
        </section>
      )
    }

    {/* Tech Stack */}
    <section
      class="section animate"
      id="tech-stack"
      style="animation-delay: 0.5s"
    >
      <h2>Tech Stack</h2>
      <div class="tech-grid">
        {
          technologies.map((tech) => (
            <div class="tech-card">
              <h4>{tech.heading}</h4>
              <ul>
                {tech.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {/* FAQ */}
    <section class="section animate" id="faq" style="animation-delay: 0.6s">
      <h2>FAQ</h2>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.question}</summary>
              <div class="faq-answer">{faq.answer}</div>
            </details>
          ))
        }
      </div>
    </section>

    {/* CTA */}
    <section class="cta-banner animate" style="animation-delay: 0.7s">
      <h2>{cta.heading}</h2>
      <p>{cta.description}</p>
      <a
        href={cta.url}
        class="cta-btn primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        {cta.label}
      </a>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.expressive-code').forEach((frame) => {
    const btn = frame.querySelector<HTMLButtonElement>('.copy-btn');
    const pre = frame.querySelector('pre');
    if (!btn || !pre) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
      } catch {
        btn.textContent = 'Failed';
      }
      window.setTimeout(() => {
        btn.textContent = 'Copy';
        btn.classList.remove('copied');
      }, 2000);
    });
  });
</script>
