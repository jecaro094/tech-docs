  <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
    <span class="tag">Cache</span>
    <span class="tag">Hash Map</span>
    <span class="tag">Linked List</span>
  </div>

  <CodeBlock language="TypeScript" code={lruCacheCode} />

  <hr />

  <h2>API Patterns</h2>

  <h3>Retry with Backoff</h3>

  <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
    <span class="tag">Resiliencia</span>
    <span class="tag">API</span>
    <span class="tag">Error Handling</span>
  </div>

  <CodeBlock language="TypeScript" code={retryCode} />

  <div class="callout callout-success">
    <div class="callout-title">✅ Cuándo usar</div>
    <p>
      <strong>Úsalo para:</strong> Llamadas a APIs externas, operaciones de red, servicios con disponibilidad limitada.<br />
      <strong>No lo uses para:</strong> Errores de validación, errores de autenticación, o errores que no son temporales.
    </p>
  </div>

  <hr />

  <h2>React Patterns</h2>

  <h3>Custom Hook: useDebounce</h3>

  <CodeBlock language="React + TypeScript" code={useDebounceCode} />

  <script>
    document.querySelectorAll('.tab-button').forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab');
        const container = button.closest('.tabs');
        
        // Desactivar todos
        container?.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
        container?.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        
        // Activar seleccionado
        button.classList.add('active');
        container?.querySelector(`#${tabId}`)?.classList.add('active');
      });
    });
  </script>
</Layout>
