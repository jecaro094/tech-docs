---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
import { buildSidebarTree } from '../lib/sidebar';
import { getSection } from '../lib/sections';
import { formatDate } from '../lib/doc-meta';
import SectionIcon from '../components/SectionIcon.astro';
import DocCard from '../components/DocCard.astro';

const docs = (await getCollection('techDocs')).sort((a, b) =>
  (a.data.title ?? a.id).localeCompare(b.data.title ?? b.id),
);

const sidebarTree = buildSidebarTree(docs);

// Cards: flatten with their section so "Recent" and the groups share one shape.
const cards = sidebarTree.flatMap((group) =>
  group.items.map((item) => ({ ...item, section: group.label })),
);
const recent = [...cards]
  .filter((c) => c.updated)
  .sort((a, b) => b.updated!.localeCompare(a.updated!))
  .slice(0, 3);
const allTags = [...new Set(cards.flatMap((c) => c.tags ?? []))].sort();
---

<Layout
  title="Tech Docs"
  description="Write-ups on the technologies I use, the projects I've built, and the systems and designs I've learned along the way."
  sidebarTree={sidebarTree}
>
  <main>
    <section class="hero animate" style="animation-delay: 0.1s">
      <h1 class="gradient-text">Tech Docs</h1>
      <p class="tagline">A technical portfolio.</p>
      <p class="subtitle">
        Write-ups on the technologies I use, the projects I've built, and the
        systems and designs I've learned along the way.
      </p>
    </section>

    {
      docs.length > 0 && (
        <div class="search-bar animate" style="animation-delay: 0.15s">
          <input
            type="search"
            id="doc-search"
            class="search-input"
            placeholder="Filter docs by title…  (⌘K searches everything)"
            aria-label="Filter docs by title"
            autocomplete="off"
          />
        </div>
      )
    }

    <section class="section animate" id="docs" style="animation-delay: 0.2s">
      <h2>Documentation</h2>
      {
        docs.length === 0 ? (
          <p class="subtitle">
            No docs found in <code>DOCS_DIR</code> yet. Drop a <code>.md</code>{' '}
            file there and it shows up here.
          </p>
        ) : (
          <>
            {allTags.length > 0 && (
              <div class="tag-filter" role="group" aria-label="Filter by tag">
                {allTags.map((t) => (
                  <button type="button" class="tag-chip" data-tag={t.toLowerCase()} aria-pressed="false">{t}</button>
                ))}
              </div>
            )}
            <p class="subtitle" id="doc-search-empty" hidden aria-live="polite">
              No docs match your search.
            </p>
            {recent.length > 0 && cards.length > 3 && (
              <div class="recent" id="recent">
                <h3 class="doc-group-title recent-title">Recently updated</h3>
                <div class="features-grid">
                  {recent.map((item) => <DocCard item={item} showSection />)}
                </div>
              </div>
            )}
            {sidebarTree.map((group) => (
              <div class="doc-group" data-doc-group>
                <h3 class="doc-group-title">
                  <SectionIcon name={group.label} size={18} />
                  {group.label}
                  <span class="doc-group-count">{group.items.length} {group.items.length === 1 ? 'doc' : 'docs'}</span>
                </h3>
                <div class="features-grid">
                  {group.items.map((item) => <DocCard item={{ ...item, section: group.label }} />)}
                </div>
              </div>
            ))}
          </>
        )
      }
    </section>
  </main>
</Layout>

{
  docs.length > 0 && (
    <script>
      const input = document.getElementById('doc-search') as HTMLInputElement;
      const groups = document.querySelectorAll<HTMLElement>('[data-doc-group]');
      const recent = document.getElementById('recent');
      const empty = document.getElementById('doc-search-empty');
      const chips = document.querySelectorAll<HTMLButtonElement>('.tag-chip');
      let activeTag = '';

      function apply() {
        const query = input.value.trim().toLowerCase();
        let anyVisible = false;

        for (const group of groups) {
          let groupHasMatch = false;
          const cards = group.querySelectorAll<HTMLElement>('[data-doc-title]');
          for (const card of cards) {
            const tags = (card.dataset.docTags ?? '').split('|');
            const matches =
              card.dataset.docTitle!.includes(query) && (!activeTag || tags.includes(activeTag));
            card.hidden = !matches;
            if (matches) groupHasMatch = true;
          }
          group.hidden = !groupHasMatch;
          if (groupHasMatch) anyVisible = true;
        }

        // "Recently updated" is a shortcut, not a result set — hide it while filtering.
        if (recent) recent.hidden = Boolean(query || activeTag);
        if (empty) empty.hidden = anyVisible;
      }

      input.addEventListener('input', apply);
      chips.forEach((chip) =>
        chip.addEventListener('click', () => {
          const next = chip.dataset.tag === activeTag ? '' : chip.dataset.tag!;
          activeTag = next;
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tag === next)));
          apply();
        }),
      );
    </script>
  )
}
