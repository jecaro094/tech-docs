---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const docs = (await getCollection('techDocs')).sort((a, b) =>
  (a.data.title ?? a.id).localeCompare(b.data.title ?? b.id),
);
---

<Layout
  title="Tech Docs"
  description="Technical documentation for my projects"
>
  <main>
    <section class="hero animate" style="animation-delay: 0.1s">
      <h1 class="gradient-text">Tech Docs</h1>
      <p class="tagline">Technical documentation for my projects</p>
      <p class="subtitle">
        A collection of technical documentation showcasing architecture
        decisions, code examples, and deployment strategies.
      </p>
    </section>

    <section class="section animate" id="docs" style="animation-delay: 0.2s">
      <h2>Documentation</h2>
      {
        docs.length === 0 ? (
          <p class="subtitle">
            No docs found in <code>DOCS_DIR</code> yet. Drop a <code>.md</code>{' '}
            file there and it shows up here.
          </p>
        ) : (
          <div class="features-grid">
            {docs.map((doc) => (
              <a href={`/tech-docs/${doc.id}`} class="feature-card">
                <h3>{doc.data.title ?? doc.id}</h3>
                {doc.data.tagline && <p>{doc.data.tagline}</p>}
              </a>
            ))}
          </div>
        )
      }
    </section>
  </main>
</Layout>
