---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const docs = await getCollection('techDocs');
---

<Layout
  title="Tech Docs"
  description="Technical documentation for my projects"
>
  <main>
    <section class="hero animate" style="animation-delay: 0.1s">
      <h1 class="gradient-text">Tech Docs</h1>
      <p class="tagline">Technical documentation for my projects</p>
      <p class="subtitle">
        A collection of technical documentation showcasing architecture
        decisions, code examples, and deployment strategies.
      </p>
    </section>

    <section class="section animate" id="docs" style="animation-delay: 0.2s">
      <h2>Documentation</h2>
      <div class="features-grid">
        {
          docs.map((doc) => (
            <a href={`/tech-docs/${doc.id}`} class="feature-card">
              <h3>{doc.data.title}</h3>
              <p>{doc.data.tagline}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
