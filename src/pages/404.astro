---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
---

<Layout title="Not found — Tech Docs" description="This page doesn't exist.">
  <main class="not-found">
    <p class="not-found-code gradient-text">404</p>
    <h1>Nothing here</h1>
    <p class="subtitle">The page you're looking for doesn't exist or has moved.</p>
    <p><a class="not-found-link" href={withBase()}>← Back to all docs</a> · press <kbd class="search-kbd">/</kbd> to search</p>
  </main>
</Layout>

<style is:global>
  .not-found { text-align: center; padding-top: 6rem; }
  .not-found-code { font-family: var(--font-mono); font-size: 5.5rem; font-weight: 700; margin: 0; line-height: 1; }
  .not-found h1 { margin: 0.5rem 0; }
  .not-found .subtitle { color: var(--muted); margin-bottom: 1.5rem; }
</style>
