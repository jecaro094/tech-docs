# Path to the directory that holds the Markdown docs. The docs are committed
# to this repo under ./docs.
DOCS_DIR=./docs

# "true" exposes the dev-only Markdown editor from a non-dev build
# (e.g. `npm run build && npm run preview`). Unset → the editor is available
# under `npm run dev` only. The deployed GitHub Pages build must stay "false".
ENABLE_EDITOR=false
